# LEIFKEN self-host image: native Node runtime (src/node-runtime), no workerd.
# Follows the upstream Dockerfile.selfhost pattern: the image carries sources
# plus node_modules, and the client/server build runs at container start
# (docker-entrypoint.node.sh) because vite inlines envPrefix'd values like
# AUTH_MODE into the client bundle. One image serves every configuration.
FROM node:22

ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH

WORKDIR /app

RUN corepack enable && corepack prepare pnpm@10.30.1 --activate

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
# better-sqlite3 (audit scratchpad) needs its native build step; the
# workspace's onlyBuiltDependencies allowlists it.
RUN pnpm install --frozen-lockfile

COPY . .

# Optional: bake the vite build into the image (GitHub Actions, image.yml).
# Without PREBUILD_COMMIT nothing changes: the build runs at container start.
# With it, the build-relevant flags come in as build args and must equal the
# runtime values in Coolify; the entrypoint compares fingerprints and falls
# back to a runtime build on any difference. No secrets are needed here.
ARG PREBUILD_COMMIT=
ARG VITE_SHOW_DEVTOOLS
ARG AUTH_MODE
ARG BYPASS_EMAIL_VERIFICATION
ARG SIGNUP_DISABLED
ARG GOOGLE_AUTH_DISABLED
ARG AUTHENTIK_AUTH_ENABLED
ARG BILLING_DISABLED
RUN if [ -n "$PREBUILD_COMMIT" ]; then \
      pnpm exec vite build --config vite.config.node.ts \
      && SOURCE_COMMIT="$PREBUILD_COMMIT" sh scripts/node-build-fingerprint.sh > dist-node/.openseo-node-build-env \
      && mv dist-node /app/dist-node-image; \
    fi

EXPOSE 3001

HEALTHCHECK --interval=30s --timeout=10s --start-period=300s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||3001)+'/api/health').then(function(r){process.exit(r.ok?0:1)}).catch(function(){process.exit(1)})"

CMD ["sh", "docker-entrypoint.node.sh"]
