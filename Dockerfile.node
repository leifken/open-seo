# LEIFKEN self-host image: native Node runtime (src/node-runtime), no workerd.
# Follows the upstream Dockerfile.selfhost pattern: the image carries sources
# plus node_modules, and the client/server build runs at container start
# (docker-entrypoint.node.sh) because vite inlines envPrefix'd values like
# AUTH_MODE into the client bundle. One image serves every configuration.
FROM node:22

ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH

WORKDIR /app

RUN corepack enable && corepack prepare pnpm@10.30.1 --activate

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
# better-sqlite3 (audit scratchpad) needs its native build step; the
# workspace's onlyBuiltDependencies allowlists it.
RUN pnpm install --frozen-lockfile

COPY . .

EXPOSE 3001

HEALTHCHECK --interval=30s --timeout=10s --start-period=300s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||3001)+'/api/health').then(function(r){process.exit(r.ok?0:1)}).catch(function(){process.exit(1)})"

CMD ["sh", "docker-entrypoint.node.sh"]
